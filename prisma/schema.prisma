// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production: PostgreSQL (Supabase/Vercel)
  // Set DATABASE_URL env var to: postgresql://user:pass@host:port/db?schema=public
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Daftar sumber Google Sheets yang dipakai dashboard.
/// Satu sheet = satu periode (biasanya 1 bulan).
/// Hanya satu sheet yang isActive=true (yang sedang ditampilkan).
model SheetSource {
  /// cuid stable identifier
  id          String   @id @default(cuid())
  /// Label yang ditampilkan ke user, e.g. "Oktober 2026"
  label       String
  /// Google Sheets ID (dari URL)
  sheetId     String
  /// Sheet/tab GID (dari URL fragment)
  gid         String
  /// True jika sedang ditampilkan di dashboard
  isActive    Boolean  @default(false)
  /// Optional catatan admin
  note        String?
  /// Range tanggal awal data (YYYY-MM-DD), diisi otomatis saat fetch pertama
  dataStart   String?
  /// Range tanggal akhir data (YYYY-MM-DD)
  dataEnd     String?
  /// Jumlah baris terakhir kali di-fetch
  rowCount    Int?
  /// Kapan terakhir berhasil di-fetch
  lastFetchedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}
